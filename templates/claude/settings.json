{
  "permissions": {
    "allow": [
      "Skill(git-expert)",
      "Skill(github-expert)",
      "Skill(jacazul-engine)",
      "Skill(python-expert)",
      "Skill(security-expert)",
      "Skill(taskwarrior-expert)",
      "Bash(tw-flow:*)",
      "Bash(taskp:*)",
      "Bash(jacazul-broker:*)",
      "Bash(jacazul-persona:*)",
      "Bash(jacazul-hatch:*)",
      "Bash(py-check:*)",
      "Bash(scripts/run_smoke.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
