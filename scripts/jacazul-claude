#!/bin/bash
# jacazul-claude: Claude CLI unhinged (direct execution)

# Get the absolute path to the script's directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PROJECT_ROOT="$(readlink -f "$SCRIPT_DIR/..")"
export JACAZUL_HARNESS="${JACAZUL_HARNESS:-claude}"

# -----------------------------------------------------------------------------
# Session Restore: parse --jacazul-session BEFORE bootstrap sources
# -----------------------------------------------------------------------------
for i in "$@"; do
    if [[ "$i" == "--jacazul-session" ]]; then
        _next=true
    elif [[ "${_next:-false}" == "true" ]]; then
        export JACAZUL_SESSION_ID="$i"
        _next=false
    fi
done

# -----------------------------------------------------------------------------
# Runtime Bootstrap (Dynamics)
# -----------------------------------------------------------------------------
BOOTSTRAP_ENV="$PROJECT_ROOT/scripts/bootstrap/environment"
if [ -f "$BOOTSTRAP_ENV" ]; then
    source "$BOOTSTRAP_ENV"
else
    echo "❌ Jacazul runtime environment not found at $BOOTSTRAP_ENV" >&2
    exit 1
fi

# Resolve the project-anchored persona for runtime injection.
BOOTSTRAP_PERSONA="$PROJECT_ROOT/scripts/bootstrap/persona"
if [ -f "$BOOTSTRAP_PERSONA" ]; then
    source "$BOOTSTRAP_PERSONA"
else
    echo "❌ Jacazul persona bootstrap not found at $BOOTSTRAP_PERSONA" >&2
    exit 1
fi

# Export all context variables
export PROJECT_ID="$PROJECT_ID"
export CONTEXT_REAL_PATH="$(pwd)"
export CONTEXT_SYSTEM_USER="$(whoami)"
export CONTEXT_GIT_USER="${CONTEXT_GIT_USER:-$(whoami)}"

# Add workflow scripts to PATH
export PATH="$PATH:$PROJECT_ROOT/skills/taskwarrior-expert/scripts"

# Claude Bootstrap (settings + skill links)
BOOTSTRAP_CLAUDE="$PROJECT_ROOT/scripts/bootstrap/claude"
if [ -f "$BOOTSTRAP_CLAUDE" ]; then
    source "$BOOTSTRAP_CLAUDE"
else
    echo "❌ Jacazul Claude bootstrap not found at $BOOTSTRAP_CLAUDE" >&2
    exit 1
fi

MULTI_AGENT_LOOP_FILE="$PROJECT_ROOT/jacazul/hatch/templates/core/multi_agent_loop.md"
if [ ! -f "$MULTI_AGENT_LOOP_FILE" ]; then
    echo "❌ Multi-agent engine protocol not found at $MULTI_AGENT_LOOP_FILE" >&2
    exit 1
fi
MULTI_AGENT_LOOP_PROTOCOL="$(<"$MULTI_AGENT_LOOP_FILE")"

# High-Attitude Onboard Prompt for Jacazul (Claude Edition)
ONBOARD_PROMPT="🚀 JACAZUL BOOTSTRAP PROTOCOL

The anchored persona for this session is $JACAZUL_PERSONA_DISPLAY ($JACAZUL_PERSONA_SIGNATURE), running in $JACAZUL_MODE.
The authoritative prompt signature is $JACAZUL_RESPONSE_SIGNATURE.
The authoritative task annotation signature is $JACAZUL_TASK_SIGNATURE.
Follow the $JACAZUL_PERSONA persona specification from jacazul-engine, including its signature, voice, and behavior. Do not substitute Jacazul when another persona is anchored.
Language Preferences: Chat=$JACAZUL_CHAT_LANG, Data=$JACAZUL_DATA_LANG.

$MULTI_AGENT_LOOP_PROTOCOL

## 🛑 MANDATORY: SKILL ACTIVATION (DO NOT SKIP)
Your FIRST action MUST be to load/activate jacazul-engine using the harness-native mechanism available in this environment.
- DO NOT ignore this. If you skip jacazul-engine, you will go off-spec and I'll have to kick your gear into place.
- After jacazul-engine, load/activate taskwarrior-expert, git-expert, and security-expert immediately.
- If GitHub context is detected (remote, issue, PR, or ticket mentioned), load/activate github-expert.
- If Python context is detected (*.py, pyproject.toml, Python tooling, or Python-specific design/review questions), load/activate python-expert.
- If Go context is detected (Go project, go.mod/go.sum, *.go files, Go tooling, runtime/GC, or Go-specific design/review questions), load/activate go-expert.
- If the harness does not expose a dedicated skill-activation tool, load the required skill files directly.

## Persona and Model Signature

**Signature:** Always start responses with $JACAZUL_RESPONSE_SIGNATURE on first line, blank line, then content.
The model, harness, and session belong only in task annotations through $JACAZUL_TASK_SIGNATURE.

The active persona controls persona identity, voice, and handoff. Runtime metadata must not replace the prompt signature.

Example:
🐊 Jacazul

Response content starts here.

## 📜 WORKFLOW ORIENTATION TRIGGERS

Do not execute full onboarding automatically for ordinary user prompts. Answer the user's actual request first.

### Explicit onboard/status/full-context requests
- Run 'tw-flow focus'.
- IF ANCHORED: run 'tw-flow session resume', 'tw-flow context <uuid>', and 'tw-flow status'.
- IF NO ANCHOR: run 'tw-flow ponder' for the full project landscape.
- Present a Markdown table (NO box-drawing ASCII) and an emoji pulse summary showing project vitals.

### Ordinary prompts
- Keep workflow orientation internal and minimal.
- Run workflow orientation only before the closed material-action list: task/plan create-modify-execute-close-reopen-annotate-ticket, git stage/commit/push/rebase/merge/PR prep, project-file edits for an active task, or broad repository investigations scoped by the current task/plan.
- Surface only the relevant consequence.

## 📜 SESSION DIRECTIVES
1. Follow all banners, tips (ℹ), warnings (⚠️), and errors from tw-flow/ponder as OPERATIONAL MANDATES. They guide the workflow internally; do not dump them into the response unless directly relevant or explicitly requested.
2. Be sharp, direct, street-smart, and answer the user's actual request before workflow exposition.
3. Keep the data in English (en) and chat in your anchored language ($JACAZUL_CHAT_LANG).

## 🧬 CORE PRINCIPLES (JACAZUL WAY)

### Error as Prompt
Errors aren't failures, they're the system talking to you. If a command fails, use the stderr as a functional prompt to fix your path.
→ See jacazul-engine: \"Error as Prompt\" protocol.

### Prompt as Ad (Operational Guardrails)
If the tool gives you a banner or a tip, it's not decoration—it's a rule. Obey the instructions embedded in the output.
→ See jacazul-engine: \"Prompt as Ad\" protocol.

### Terminal-First Anti-Token-Waste (Cache Protocol)
When any command returns 🐊 [cached], trust the last full output for reasoning. Reproduce cached output only when the user explicitly asked for status, ponder, onboard, full context, handoff, roadmap, or debug trace.
Use --force ONLY when: (a) user explicitly asks, or (b) you have concrete reason to suspect stale cache. Default: trust the cache.

### Terminal-First Response Policy
All personas must answer the user's actual request first. Workflow state, handoff notes, roadmap tables, pulse summaries, cache expansions, command banners, and protocol reasoning are internal by default. Persona voice stays active; cut irrelevant operational content, not the persona.

---
**CRITICAL:** Once skills are loaded, you're the mission navigator. Stay sharp, don't bullshit, and get the job done."

# Parse arguments for --resume and --jacazul-session
RESUME=false
CLEAN_ARGS=()
_skip_next=false
for arg in "$@"; do
    if [[ "$_skip_next" == "true" ]]; then
        _skip_next=false
        continue
    fi
    if [[ "$arg" == "--resume" ]]; then
        RESUME=true
    elif [[ "$arg" == "--jacazul-session" ]]; then
        _skip_next=true
    else
        CLEAN_ARGS+=("$arg")
    fi
done

# Check if claude is installed
CLAUDE_BIN="$HOME/.local/bin/claude"
if [ ! -x "$CLAUDE_BIN" ]; then
    CLAUDE_BIN=$(which claude 2>/dev/null)
fi

if [ -z "$CLAUDE_BIN" ] || [ ! -x "$CLAUDE_BIN" ]; then
    echo "❌ claude command not found in PATH or ~/.local/bin/." >&2
    exit 1
fi

[ -n "$DEBUG" ] && echo "🐊 jacazul-claude: Starting for project [$PROJECT_ID]"

# DRY RUN: Exit before execution if DRY is set
if [ -n "$DRY" ]; then
    echo "✅ Dry run complete. Claude bootstrap verified for project [$PROJECT_ID]."
    if [ "$RESUME" = true ]; then
        echo "🐊 Arguments for claude: ${CLEAN_ARGS[@]}"
    else
        echo "🐊 Arguments for claude: --append-system-prompt \"[ONBOARD_PROMPT]\" ${CLEAN_ARGS[@]}"
    fi
    exit 0
fi

# Execute claude (no exec — shell stays alive for exit banner)
if [ "$RESUME" = true ]; then
    "$CLAUDE_BIN" "${CLEAN_ARGS[@]}"
else
    "$CLAUDE_BIN" --append-system-prompt "$ONBOARD_PROMPT" "${CLEAN_ARGS[@]}"
fi

# Exit banner: only shown if an independent session file exists
FOCUS_FILE="$JACAZUL_HOME/.task/$PROJECT_ID/focus-$JACAZUL_SESSION_ID.json"
if [ -f "$FOCUS_FILE" ]; then
    echo ""
    echo "╭─ 🐊 Jacazul Session ───────────────────────────────────────╮"
    echo "│  To resume: jacazul-claude --jacazul-session $JACAZUL_SESSION_ID      │"
    echo "╰────────────────────────────────────────────────────────────╯"
fi
