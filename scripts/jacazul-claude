#!/bin/bash
# jacazul-claude: Claude CLI unhinged (direct execution)

# Get the absolute path to the script's directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PROJECT_ROOT="$(readlink -f "$SCRIPT_DIR/..")"
export JACAZUL_HARNESS="${JACAZUL_HARNESS:-claude}"

# -----------------------------------------------------------------------------
# Session Restore: parse --jacazul-session BEFORE bootstrap sources
# -----------------------------------------------------------------------------
for i in "$@"; do
    if [[ "$i" == "--jacazul-session" ]]; then
        _next=true
    elif [[ "${_next:-false}" == "true" ]]; then
        export JACAZUL_SESSION_ID="$i"
        _next=false
    fi
done

# -----------------------------------------------------------------------------
# Runtime Bootstrap (Dynamics)
# -----------------------------------------------------------------------------
BOOTSTRAP_ENV="$PROJECT_ROOT/scripts/bootstrap/environment"
if [ -f "$BOOTSTRAP_ENV" ]; then
    source "$BOOTSTRAP_ENV"
else
    echo "❌ Jacazul runtime environment not found at $BOOTSTRAP_ENV" >&2
    exit 1
fi

# Resolve the project-anchored persona for runtime injection.
BOOTSTRAP_PERSONA="$PROJECT_ROOT/scripts/bootstrap/persona"
if [ -f "$BOOTSTRAP_PERSONA" ]; then
    source "$BOOTSTRAP_PERSONA"
else
    echo "❌ Jacazul persona bootstrap not found at $BOOTSTRAP_PERSONA" >&2
    exit 1
fi

# Export all context variables
export PROJECT_ID="$PROJECT_ID"
export CONTEXT_REAL_PATH="$(pwd)"
export CONTEXT_SYSTEM_USER="$(whoami)"
export CONTEXT_GIT_USER="${CONTEXT_GIT_USER:-$(whoami)}"

# Add workflow scripts to PATH
export PATH="$PATH:$PROJECT_ROOT/skills/taskwarrior-expert/scripts"

# Jacazul owns Claude state by default unless the user explicitly overrides it.
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$JACAZUL_HOME/agents/claude}"

# Claude Bootstrap (settings + skill links)
BOOTSTRAP_CLAUDE="$PROJECT_ROOT/scripts/bootstrap/claude"
if [ -f "$BOOTSTRAP_CLAUDE" ]; then
    source "$BOOTSTRAP_CLAUDE"
else
    echo "❌ Jacazul Claude bootstrap not found at $BOOTSTRAP_CLAUDE" >&2
    exit 1
fi

# Render the shared session prompt: prompts/onboard.md plus the active voice.
BOOTSTRAP_ONBOARD="$PROJECT_ROOT/scripts/bootstrap/onboard"
if [ -f "$BOOTSTRAP_ONBOARD" ]; then
    source "$BOOTSTRAP_ONBOARD" || exit 1
else
    echo "❌ Jacazul onboard bootstrap not found at $BOOTSTRAP_ONBOARD" >&2
    exit 1
fi

# Parse arguments for --resume and --jacazul-session
RESUME=false
CLEAN_ARGS=()
_skip_next=false
for arg in "$@"; do
    if [[ "$_skip_next" == "true" ]]; then
        _skip_next=false
        continue
    fi
    if [[ "$arg" == "--resume" ]]; then
        RESUME=true
    elif [[ "$arg" == "--jacazul-session" ]]; then
        _skip_next=true
    else
        CLEAN_ARGS+=("$arg")
    fi
done

# Check if claude is installed
CLAUDE_BIN="$HOME/.local/bin/claude"
if [ ! -x "$CLAUDE_BIN" ]; then
    CLAUDE_BIN=$(which claude 2>/dev/null)
fi

if [ -z "$CLAUDE_BIN" ] || [ ! -x "$CLAUDE_BIN" ]; then
    echo "❌ claude command not found in PATH or ~/.local/bin/." >&2
    exit 1
fi

[ -n "$DEBUG" ] && echo "🐊 jacazul-claude: Starting for project [$PROJECT_ID]"

# DRY RUN: Exit before execution if DRY is set
if [ -n "$DRY" ]; then
    echo "✅ Dry run complete. Claude bootstrap verified for project [$PROJECT_ID]."
    if [ "$RESUME" = true ]; then
        echo "🐊 Arguments for claude: ${CLEAN_ARGS[@]}"
    else
        echo "🐊 Arguments for claude: --append-system-prompt \"[ONBOARD_PROMPT]\" ${CLEAN_ARGS[@]}"
    fi
    exit 0
fi

# Execute claude (no exec — shell stays alive for exit banner)
if [ "$RESUME" = true ]; then
    "$CLAUDE_BIN" "${CLEAN_ARGS[@]}"
else
    "$CLAUDE_BIN" --append-system-prompt "$ONBOARD_PROMPT" "${CLEAN_ARGS[@]}"
fi

# Exit banner: only shown if an independent session file exists
FOCUS_FILE="$JACAZUL_HOME/.task/$PROJECT_ID/focus-$JACAZUL_SESSION_ID.json"
if [ -f "$FOCUS_FILE" ]; then
    echo ""
    echo "╭─ 🐊 Jacazul Session ───────────────────────────────────────╮"
    echo "│  To resume: jacazul-claude --jacazul-session $JACAZUL_SESSION_ID      │"
    echo "╰────────────────────────────────────────────────────────────╯"
fi
