#!/bin/bash
# jacazul-antigravity: Antigravity CLI native launcher

# Get the absolute path to the script's directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PROJECT_ROOT="$(readlink -f "$SCRIPT_DIR/..")"

# -----------------------------------------------------------------------------
# Session Restore: parse --jacazul-session BEFORE bootstrap sources
# -----------------------------------------------------------------------------
for i in "$@"; do
    if [[ "$i" == "--jacazul-session" ]]; then
        _next=true
    elif [[ "${_next:-false}" == "true" ]]; then
        export JACAZUL_SESSION_ID="$i"
        _next=false
    fi
done

# -----------------------------------------------------------------------------
# Runtime Bootstrap (Dynamics)
# -----------------------------------------------------------------------------
BOOTSTRAP_ENV="$PROJECT_ROOT/scripts/bootstrap/environment"
if [ -f "$BOOTSTRAP_ENV" ]; then
    source "$BOOTSTRAP_ENV"
else
    echo "❌ Jacazul runtime environment not found at $BOOTSTRAP_ENV" >&2
    exit 1
fi

# Export all context variables
export PROJECT_ID="$PROJECT_ID"
export CONTEXT_REAL_PATH="$(pwd)"
export CONTEXT_SYSTEM_USER="$(whoami)"
export CONTEXT_GIT_USER="${CONTEXT_GIT_USER:-$(whoami)}"
export GEMINI_INSTRUCTIONS_DIR="$PROJECT_ROOT/templates/context/instructions"

# Add workflow scripts to PATH
export PATH="$PATH:$PROJECT_ROOT/skills/taskwarrior-expert/scripts"

# Antigravity Bootstrap (settings + skill links)
BOOTSTRAP_ANTIGRAVITY="$PROJECT_ROOT/scripts/bootstrap/antigravity"
if [ -f "$BOOTSTRAP_ANTIGRAVITY" ]; then
    source "$BOOTSTRAP_ANTIGRAVITY"
else
    [ -n "$DEBUG" ] && echo "⚠️  Antigravity bootstrap script not found at $BOOTSTRAP_ANTIGRAVITY." >&2
fi

ONBOARD_TEMPLATE="$PROJECT_ROOT/prompts/onboard.md"

# Load and Process Onboard Prompt
PROCESSED_ONBOARD=$(mktemp)
if [ -f "$ONBOARD_TEMPLATE" ]; then
    (
        export JACAZUL_MODE="${JACAZUL_MODE:-COUNSELOR}"
        export JACAZUL_CHAT_LANG="${JACAZUL_CHAT_LANG:-pt-br}"
        export JACAZUL_DATA_LANG="${JACAZUL_DATA_LANG:-en}"
        
        eval "cat <<EOF
$(cat "$ONBOARD_TEMPLATE")
EOF" > "$PROCESSED_ONBOARD"
    )
else
    echo "⚠️  Onboard template missing at $ONBOARD_TEMPLATE" >&2
    echo "🚀 JACAZUL BOOTSTRAP PROTOCOL" > "$PROCESSED_ONBOARD"
fi

ONBOARD_TEXT_FALLBACK=$(cat "$PROCESSED_ONBOARD")
rm -f "$PROCESSED_ONBOARD"

# Parse arguments for --resume and --jacazul-session
RESUME=false
CLEAN_ARGS=()
_skip_next=false
for arg in "$@"; do
    if [[ "$_skip_next" == "true" ]]; then
        _skip_next=false
        continue
    fi
    if [[ "$arg" == "--resume" ]]; then
        RESUME=true
    elif [[ "$arg" == "--jacazul-session" ]]; then
        _skip_next=true
    else
        CLEAN_ARGS+=("$arg")
    fi
done

# Check if agy is installed
AGY_BIN=$(command -v agy 2>/dev/null)
if [ -z "$AGY_BIN" ]; then
    AGY_BIN="agy"
fi

# Execute logic
if [ "$RESUME" = true ]; then
    set -- "${CLEAN_ARGS[@]}"
else
    if [ ${#CLEAN_ARGS[@]} -eq 0 ]; then
        set -- -i "$ONBOARD_TEXT_FALLBACK"
    else
        USER_PROMPT="${CLEAN_ARGS[*]}"
        set -- -i "$(printf "%s\n\n%s" "$ONBOARD_TEXT_FALLBACK" "$USER_PROMPT")"
    fi
fi

if [ "$AGY_BIN" = "agy" ] && ! command -v agy &> /dev/null; then
    echo "❌ agy command not found in PATH." >&2
    exit 1
fi

[ -n "$DEBUG" ] && echo "🐊 jacazul-antigravity: Starting for project [$PROJECT_ID]"

# DRY RUN: Exit before execution if DRY is set
if [ -n "$DRY" ]; then
    echo "✅ Dry run complete. Antigravity bootstrap verified for project [$PROJECT_ID]."
    echo "🐊 Arguments for agy: $@"
    exit 0
fi

[ -z "$DRY" ] && echo "🐊 Active Session: Mode=$JACAZUL_MODE | Lang=$JACAZUL_CHAT_LANG"

"$AGY_BIN" "$@"

# Exit banner: only shown if an independent session file exists
FOCUS_FILE="$JACAZUL_HOME/.task/$PROJECT_ID/focus-$JACAZUL_SESSION_ID.json"
if [ -f "$FOCUS_FILE" ]; then
    echo ""
    echo "╭─ 🐊 Jacazul Session ───────────────────────────────────────╮"
    echo "│  To resume: jacazul-antigravity --jacazul-session $JACAZUL_SESSION_ID      │"
    echo "╰────────────────────────────────────────────────────────────╯"
fi