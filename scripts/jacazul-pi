#!/bin/bash
# jacazul-pi: Jacazul for Raspberry Pi via pi CLI (local model)

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PROJECT_ROOT="$(readlink -f "$SCRIPT_DIR/..")"
export JACAZUL_HARNESS="${JACAZUL_HARNESS:-pi}"

# RPC mode requires stdout to remain a strict JSONL stream. Keep launcher
# bootstrap messages and exit banners on stderr when pi is used as a child.
RPC_MODE=false
_mode_value_pending=false
for arg in "$@"; do
    if [[ "$_mode_value_pending" == "true" ]]; then
        [ "$arg" = "rpc" ] && RPC_MODE=true
        _mode_value_pending=false
    elif [[ "$arg" == "--mode" ]]; then
        _mode_value_pending=true
    elif [[ "$arg" == "--mode=rpc" ]]; then
        RPC_MODE=true
    fi
done
unset _mode_value_pending

source_bootstrap() {
    if [ "$RPC_MODE" = true ]; then
        source "$1" >&2
    else
        source "$1"
    fi
}

# -----------------------------------------------------------------------------
# Session Restore: parse --jacazul-session BEFORE bootstrap sources
# -----------------------------------------------------------------------------
for i in "$@"; do
    if [[ "$i" == "--jacazul-session" ]]; then
        _next=true
    elif [[ "${_next:-false}" == "true" ]]; then
        export JACAZUL_SESSION_ID="$i"
        _next=false
    fi
done

# -----------------------------------------------------------------------------
# Runtime Bootstrap (Dynamics)
# -----------------------------------------------------------------------------
BOOTSTRAP_ENV="$PROJECT_ROOT/scripts/bootstrap/environment"
if [ -f "$BOOTSTRAP_ENV" ]; then
    source_bootstrap "$BOOTSTRAP_ENV"
else
    echo "❌ Jacazul runtime environment not found at $BOOTSTRAP_ENV" >&2
    exit 1
fi

# Resolve the project-anchored persona for runtime injection.
BOOTSTRAP_PERSONA="$PROJECT_ROOT/scripts/bootstrap/persona"
if [ -f "$BOOTSTRAP_PERSONA" ]; then
    source_bootstrap "$BOOTSTRAP_PERSONA"
else
    echo "❌ Jacazul persona bootstrap not found at $BOOTSTRAP_PERSONA" >&2
    exit 1
fi

# Export all context variables
export PROJECT_ID="$PROJECT_ID"
export CONTEXT_REAL_PATH="$(pwd)"
export CONTEXT_SYSTEM_USER="$(whoami)"
export CONTEXT_GIT_USER="${CONTEXT_GIT_USER:-$(whoami)}"

# Add workflow scripts to PATH
export PATH="$PATH:$PROJECT_ROOT/skills/taskwarrior-expert/scripts"

# Jacazul owns Pi state by default unless the user explicitly overrides it.
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$JACAZUL_HOME/agents/pi}"

# -----------------------------------------------------------------------------
# Pi Bootstrap (auto-update + pi-specific setup)
# -----------------------------------------------------------------------------
source_bootstrap "$PROJECT_ROOT/scripts/bootstrap/pi"

# Render the shared session prompt: prompts/onboard.md plus the active voice.
BOOTSTRAP_ONBOARD="$PROJECT_ROOT/scripts/bootstrap/onboard"
if [ -f "$BOOTSTRAP_ONBOARD" ]; then
    source_bootstrap "$BOOTSTRAP_ONBOARD" || exit 1
else
    echo "❌ Jacazul onboard bootstrap not found at $BOOTSTRAP_ONBOARD" >&2
    exit 1
fi

# A host UI exists only in RPC mode or inside jacazul.nvim. The jacazul-ui
# skill and the jacazul-ui extension guidance load only then; the extension
# owns the host-specific guidance.
if [ "$RPC_MODE" = true ] || [ "${JACAZUL_HOST:-}" = "jacazul.nvim" ]; then
    export JACAZUL_UI="1"
    ONBOARD_PROMPT="${ONBOARD_PROMPT}

Load jacazul-ui in the first turn: this session has a host UI."
fi

# Parse arguments for --resume and --jacazul-session
RESUME=false
CLEAN_ARGS=()
_skip_next=false
for arg in "$@"; do
    if [[ "$_skip_next" == "true" ]]; then
        _skip_next=false
        continue
    fi
    if [[ "$arg" == "--resume" ]]; then
        RESUME=true
    elif [[ "$arg" == "--jacazul-session" ]]; then
        _skip_next=true
    else
        CLEAN_ARGS+=("$arg")
    fi
done

# Check if pi is installed
PI_BIN=$(which pi 2>/dev/null)

if [ -z "$PI_BIN" ] || [ ! -x "$PI_BIN" ]; then
    echo "❌ pi command not found in PATH." >&2
    exit 1
fi

PASSTHROUGH=false
case "${CLEAN_ARGS[0]:-}" in
    install|remove|list|update|config)
        PASSTHROUGH=true
        ;;
esac

if [ -n "$DEBUG" ]; then
    if [ "$RPC_MODE" = true ]; then
        echo "🐊 jacazul-pi: Starting for project [$PROJECT_ID]" >&2
    else
        echo "🐊 jacazul-pi: Starting for project [$PROJECT_ID]"
    fi
fi

# DRY RUN: Exit before execution if DRY is set
if [ -n "$DRY" ]; then
    echo "✅ Dry run complete. Pi bootstrap verified for project [$PROJECT_ID]."
    if [ "$RESUME" = true ] || [ "$PASSTHROUGH" = true ]; then
        echo "🐊 Arguments for pi: ${CLEAN_ARGS[*]}"
    else
        echo "🐊 Arguments for pi: --append-system-prompt \"[ONBOARD_PROMPT]\" ${CLEAN_ARGS[*]}"
    fi
    exit 0
fi

# Execute pi (no exec — shell stays alive for exit banner)
if [ "$RESUME" = true ] || [ "$PASSTHROUGH" = true ]; then
    "$PI_BIN" "${CLEAN_ARGS[@]}"
else
    "$PI_BIN" --append-system-prompt "$ONBOARD_PROMPT" "${CLEAN_ARGS[@]}"
fi

# Exit banner: only shown if an independent session file exists
if [ -n "${JACAZUL_SESSION_ID:-}" ]; then
    FOCUS_FILE="$JACAZUL_HOME/.task/$PROJECT_ID/focus-$JACAZUL_SESSION_ID.json"
    if [ -f "$FOCUS_FILE" ]; then
        if [ "$RPC_MODE" = true ]; then
            printf '\n' >&2
            printf '🐊 Resume: jacazul-pi --jacazul-session %s\n' "$JACAZUL_SESSION_ID" >&2
        else
            printf '\n'
            printf '🐊 Resume: jacazul-pi --jacazul-session %s\n' "$JACAZUL_SESSION_ID"
        fi
    fi
fi
