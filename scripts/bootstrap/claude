#!/bin/bash
# 🐊 Jacazul - Bootstrap for Claude CLI Settings
# Manages settings.json and symlinking of project skills to ~/.claude/skills.

# Locate the project root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
SETTINGS_FILE="$CLAUDE_DIR/settings.json"
TEMPLATE_SETTINGS="$PROJECT_ROOT/templates/claude/settings.json"
SKILLS_DIR="$CLAUDE_DIR/skills"

# 1. Ensure the Claude directory exists
if [ ! -d "$CLAUDE_DIR" ]; then
    echo "🐊 Creating Claude directory at $CLAUDE_DIR..."
    mkdir -p -- "$CLAUDE_DIR"
fi

# 2. Ensure settings.json exists (use template if available)
if [ ! -f "$SETTINGS_FILE" ]; then
    if [ -f "$TEMPLATE_SETTINGS" ]; then
        echo "🐊 Initializing Claude settings.json from template..."
        cp -- "$TEMPLATE_SETTINGS" "$SETTINGS_FILE"
    else
        echo "{}" > "$SETTINGS_FILE"
    fi
fi

# 3. Surgical update with jq
# Unions permissions.allow from template into existing settings (idempotent, never overwrites user entries)
if [ -f "$TEMPLATE_SETTINGS" ] && command -v jq &> /dev/null; then
    TMP_FILE=$(mktemp)
    TEMPLATE_ALLOWS=$(jq '.permissions.allow // []' "$TEMPLATE_SETTINGS")
    jq --argjson adds "$TEMPLATE_ALLOWS" '
        .permissions.allow = ((.permissions.allow // []) + $adds | unique)
    ' "$SETTINGS_FILE" > "$TMP_FILE" && mv "$TMP_FILE" "$SETTINGS_FILE"
fi

if [ -n "$DEBUG" ]; then
    echo "✅ Jacazul: Claude settings.json verified (SessionStart hook active)."
fi

# 4. Ensure the skills directory exists
if [ ! -d "$SKILLS_DIR" ]; then
    if [ -n "$DEBUG" ]; then
        echo "🐊 Creating Claude skills directory at $SKILLS_DIR..."
    fi
    mkdir -p -- "$SKILLS_DIR"
fi

# 5. Link Global Skills (Surgical)
# Link valid skill directories from the project root to ~/.claude/skills.
for skill_dir in "$PROJECT_ROOT/skills"/*; do
    [ -d "$skill_dir" ] || continue
    [ -f "$skill_dir/SKILL.md" ] || continue
    name=$(basename "$skill_dir")

    target="$SKILLS_DIR/$name"
    # Always ensure the link points to the CURRENT PROJECT_ROOT
    if [ -L "$target" ]; then
        current_target=$(readlink -f "$target")
        expected_target=$(readlink -f "$skill_dir")
        if [ "$current_target" != "$expected_target" ]; then
            if [ -n "$DEBUG" ]; then
                echo "⚠️  Claude skill $name points to wrong location. Re-linking..."
            fi
            ln -sfn -- "$skill_dir" "$target"
        fi
    else
        if [ -n "$DEBUG" ]; then
            echo "🐊 Linking global Claude skill: $name"
        fi
        ln -sfn -- "$skill_dir" "$target"
    fi
done

# Log only in DEBUG mode
if [ -n "$DEBUG" ]; then
    echo "✅ Jacazul: Claude configuration verified."
fi
