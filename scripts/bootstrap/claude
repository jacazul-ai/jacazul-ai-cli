#!/bin/bash
# 🐊 Jacazul - Bootstrap for Claude CLI Settings
# Manages settings.json and symlinking of project skills into the anchored config dir.

# Locate the project root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-${JACAZUL_HOME:-$HOME/.jacazul-ai}/agents/claude}"
SETTINGS_FILE="$CLAUDE_CONFIG_DIR/settings.json"
TEMPLATE_SETTINGS="$PROJECT_ROOT/templates/claude/settings.json"
SKILLS_DIR="$CLAUDE_CONFIG_DIR/skills"

# Legacy migration (mirrors scripts/bootstrap/pi)
# Moves the pre-anchorage ~/.claude tree into the anchored location exactly
# once. Gated the same way pi is: the anchored path must differ from the legacy
# one, the legacy tree must exist as a real directory, and the anchored target
# must not exist yet. The tree is moved, never copied — .credentials.json is a
# live secret and must not be duplicated on disk.
LEGACY_CLAUDE_DIR="$HOME/.claude"

if [ "$CLAUDE_CONFIG_DIR" != "$LEGACY_CLAUDE_DIR" ] \
    && [ -d "$LEGACY_CLAUDE_DIR" ] \
    && [ ! -L "$LEGACY_CLAUDE_DIR" ] \
    && [ ! -e "$CLAUDE_CONFIG_DIR" ]; then

    # Claude-specific precondition with no pi equivalent: history.jsonl,
    # sessions/ and the daemon are written live. Moving the tree under a
    # running session corrupts it, so refuse instead of forcing the move.
    if pgrep -u "$USER" -x claude >/dev/null 2>&1; then
        echo "⚠️  Jacazul: another Claude session is running." >&2
        echo "   Legacy config at $LEGACY_CLAUDE_DIR was NOT migrated." >&2
        echo "   ACTION: close every Claude session, then start jacazul-claude again." >&2
    else
        echo "🐊 Migrating Claude config from $LEGACY_CLAUDE_DIR to $CLAUDE_CONFIG_DIR..."
        mkdir -p -- "$(dirname "$CLAUDE_CONFIG_DIR")"
        mv -- "$LEGACY_CLAUDE_DIR" "$CLAUDE_CONFIG_DIR"
    fi
fi

# 1. Ensure the Claude directory exists
if [ ! -d "$CLAUDE_CONFIG_DIR" ]; then
    echo "🐊 Creating Claude directory at $CLAUDE_CONFIG_DIR..."
    mkdir -p -- "$CLAUDE_CONFIG_DIR"
fi

# 2. Ensure settings.json exists (use template if available)
if [ ! -f "$SETTINGS_FILE" ]; then
    if [ -f "$TEMPLATE_SETTINGS" ]; then
        echo "🐊 Initializing Claude settings.json from template..."
        cp -- "$TEMPLATE_SETTINGS" "$SETTINGS_FILE"
    else
        echo "{}" > "$SETTINGS_FILE"
    fi
fi

# 3. Surgical update with jq
# Unions permissions.allow from template into existing settings (idempotent, never overwrites user entries)
if [ -f "$TEMPLATE_SETTINGS" ] && command -v jq &> /dev/null; then
    TMP_FILE=$(mktemp)
    TEMPLATE_ALLOWS=$(jq '.permissions.allow // []' "$TEMPLATE_SETTINGS")
    jq --argjson adds "$TEMPLATE_ALLOWS" '
        .permissions.allow = ((.permissions.allow // []) + $adds | unique)
    ' "$SETTINGS_FILE" > "$TMP_FILE" && mv "$TMP_FILE" "$SETTINGS_FILE"
fi

if [ -n "$DEBUG" ]; then
    echo "✅ Jacazul: Claude settings.json verified (SessionStart hook active)."
fi

# 4. Ensure the skills directory exists
if [ ! -d "$SKILLS_DIR" ]; then
    if [ -n "$DEBUG" ]; then
        echo "🐊 Creating Claude skills directory at $SKILLS_DIR..."
    fi
    mkdir -p -- "$SKILLS_DIR"
fi

# 5. Link Global Skills (Surgical)
# Link valid skill directories from the project root into the anchored skills dir.
for skill_dir in "$PROJECT_ROOT/skills"/*; do
    [ -d "$skill_dir" ] || continue
    [ -f "$skill_dir/SKILL.md" ] || continue
    name=$(basename "$skill_dir")

    target="$SKILLS_DIR/$name"
    # Always ensure the link points to the CURRENT PROJECT_ROOT
    if [ -L "$target" ]; then
        current_target=$(readlink -f "$target")
        expected_target=$(readlink -f "$skill_dir")
        if [ "$current_target" != "$expected_target" ]; then
            if [ -n "$DEBUG" ]; then
                echo "⚠️  Claude skill $name points to wrong location. Re-linking..."
            fi
            ln -sfn -- "$skill_dir" "$target"
        fi
    else
        if [ -n "$DEBUG" ]; then
            echo "🐊 Linking global Claude skill: $name"
        fi
        ln -sfn -- "$skill_dir" "$target"
    fi
done

# Log only in DEBUG mode
if [ -n "$DEBUG" ]; then
    echo "✅ Jacazul: Claude configuration verified."
fi
