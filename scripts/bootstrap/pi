#!/bin/bash
# 🐊 Jacazul - Bootstrap for pi CLI (Raspberry Pi local model)
# Handles auto-update of the pi binary and skill linking.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

PI_BIN=$(which pi 2>/dev/null)

if [ -z "$PI_BIN" ] || [ ! -x "$PI_BIN" ]; then
    echo "❌ pi command not found in PATH." >&2
    return 1 2>/dev/null || exit 1
fi

# 1. Auto-update: pi has no built-in auto-update mechanism
UPDATE_OUTPUT=$("$PI_BIN" update 2>&1)
UPDATE_EXIT=$?

if [ $UPDATE_EXIT -ne 0 ]; then
    echo "⚠️  pi update failed (exit $UPDATE_EXIT). Continuing with current version." >&2
    [ -n "$DEBUG" ] && echo "$UPDATE_OUTPUT" >&2
elif echo "$UPDATE_OUTPUT" | grep -qi "new version\|updated\|installing"; then
    echo "🐊 pi updated: $(echo "$UPDATE_OUTPUT" | grep -i 'version\|updated' | head -1)"
elif [ -n "$DEBUG" ]; then
    echo "✅ Jacazul: pi is up to date."
fi

# 2. Link Global Skills (Surgical)
# Mirror what bootstrap/claude does: link project skills to ~/.pi/agent/skills/
PI_SKILLS_DIR="$HOME/.pi/agent/skills"

if [ ! -d "$PI_SKILLS_DIR" ]; then
    [ -n "$DEBUG" ] && echo "🐊 Creating pi skills directory at $PI_SKILLS_DIR..."
    mkdir -p "$PI_SKILLS_DIR"
fi

for skill_dir in "$PROJECT_ROOT/skills"/*; do
    [ -d "$skill_dir" ] || continue
    [ -f "$skill_dir/SKILL.md" ] || continue
    name=$(basename "$skill_dir")
    target="$PI_SKILLS_DIR/$name"

    if [ -L "$target" ]; then
        current_target=$(readlink -f "$target")
        expected_target=$(readlink -f "$skill_dir")
        if [ "$current_target" != "$expected_target" ]; then
            [ -n "$DEBUG" ] && echo "⚠️  pi skill $name points to wrong location. Re-linking..."
            ln -sfn "$skill_dir" "$target"
        fi
    else
        [ -n "$DEBUG" ] && echo "🐊 Linking global pi skill: $name"
        ln -sfn "$skill_dir" "$target"
    fi
done

# 3. Link Global Extensions (Surgical)
# Project-owned Pi extensions live under extensions/pi/. Only production
# entrypoints are linked into Pi's global auto-discovery directory; diagnostic
# probes must be loaded explicitly so broken helpers cannot break Pi startup.
PI_EXTENSIONS_DIR="$HOME/.pi/agent/extensions"
if [ ! -d "$PI_EXTENSIONS_DIR" ]; then
    echo "🐊 Creating pi extensions directory at $PI_EXTENSIONS_DIR..."
    mkdir -p "$PI_EXTENSIONS_DIR"
fi

for legacy_name in pi-jacazul-line.ts pi-viewport-probe.ts pi-viewport-probe-impl.ts; do
    legacy_target="$PI_EXTENSIONS_DIR/$legacy_name"
    if [ -L "$legacy_target" ]; then
        legacy_source=$(readlink "$legacy_target")
        case "$legacy_source" in
            "$PROJECT_ROOT/extensions"/*)
                echo "🐊 Removing legacy pi extension link: $legacy_name"
                rm -f "$legacy_target"
                ;;
        esac
    fi
done

for extension_file in "$PROJECT_ROOT/extensions/pi/jacazul-line.ts"; do
    [ -f "$extension_file" ] || continue
    name=$(basename "$extension_file")
    target="$PI_EXTENSIONS_DIR/$name"

    if [ -L "$target" ]; then
        current_target=$(readlink -f "$target")
        expected_target=$(readlink -f "$extension_file")
        if [ "$current_target" != "$expected_target" ]; then
            echo "🐊 Re-linking pi extension: $name"
            ln -sfn "$extension_file" "$target"
        fi
    else
        echo "🐊 Linking global pi extension: $name"
        ln -sfn "$extension_file" "$target"
    fi
done

if [ -n "$DEBUG" ]; then
    echo "✅ Jacazul: pi configuration verified."
fi
