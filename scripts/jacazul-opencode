#!/bin/bash
# jacazul-opencode: Opencode CLI unhinged (direct execution)

# Get the absolute path to the script's directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PROJECT_ROOT="$(readlink -f "$SCRIPT_DIR/..")"
export JACAZUL_HARNESS="${JACAZUL_HARNESS:-opencode}"

# -----------------------------------------------------------------------------
# Session Restore: parse --jacazul-session BEFORE bootstrap sources
# -----------------------------------------------------------------------------
for i in "$@"; do
    if [[ "$i" == "--jacazul-session" ]]; then
        _next=true
    elif [[ "${_next:-false}" == "true" ]]; then
        export JACAZUL_SESSION_ID="$i"
        _next=false
    fi
done

# -----------------------------------------------------------------------------
# Runtime Bootstrap (Dynamics)
# -----------------------------------------------------------------------------
BOOTSTRAP_ENV="$PROJECT_ROOT/scripts/bootstrap/environment"
if [ -f "$BOOTSTRAP_ENV" ]; then
    source "$BOOTSTRAP_ENV"
else
    echo "❌ Jacazul runtime environment not found at $BOOTSTRAP_ENV" >&2
    exit 1
fi

# Resolve the project-anchored persona for runtime injection.
BOOTSTRAP_PERSONA="$PROJECT_ROOT/scripts/bootstrap/persona"
if [ -f "$BOOTSTRAP_PERSONA" ]; then
    source "$BOOTSTRAP_PERSONA"
else
    echo "❌ Jacazul persona bootstrap not found at $BOOTSTRAP_PERSONA" >&2
    exit 1
fi

# Export context for TUI
export PROJECT_ID="$PROJECT_ID"
export CONTEXT_REAL_PATH="$(pwd)"
export CONTEXT_SYSTEM_USER="$(whoami)"

# Add workflow scripts to PATH
export PATH="$PATH:$PROJECT_ROOT/skills/taskwarrior-expert/scripts"

# Refresh the global Opencode agent and skills before every session.
BOOTSTRAP_OPENCODE="$PROJECT_ROOT/scripts/bootstrap/opencode"
if [ -x "$BOOTSTRAP_OPENCODE" ]; then
    "$BOOTSTRAP_OPENCODE"
else
    echo "❌ Opencode bootstrap not found or not executable at $BOOTSTRAP_OPENCODE" >&2
    exit 1
fi

# 1. Verification: Opencode installation
if OPENCODE_BIN=$(command -v opencode 2>/dev/null); then
    :
elif [ -x "$HOME/.opencode/bin/opencode" ]; then
    OPENCODE_BIN="$HOME/.opencode/bin/opencode"
else
    echo "❌ opencode command not found. Install it or add it to PATH." >&2
    exit 1
fi

[ -n "$DEBUG" ] && echo "🐊 jacazul-opencode: Starting for project [$PROJECT_ID]"

# DRY RUN: Exit before execution if DRY is set
if [ -n "$DRY" ]; then
    echo "✅ Dry run complete. Opencode bootstrap verified for project [$PROJECT_ID]."
    exit 0
fi

# Keep the installed OpenCode version current without interrupting the session.
# Upgrade failures are non-blocking so a temporary network issue cannot prevent
# the user from opening the already-installed version.
if [ -n "$DEBUG" ]; then
    echo "🐊 jacazul-opencode: Updating OpenCode silently before session"
    "$OPENCODE_BIN" upgrade || true
else
    "$OPENCODE_BIN" upgrade >/dev/null 2>&1 || true
fi

# Parse arguments — strip --jacazul-session from args passed to opencode
CLEAN_ARGS=()
_skip_next=false
for arg in "$@"; do
    if [[ "$_skip_next" == "true" ]]; then
        _skip_next=false
        continue
    fi
    if [[ "$arg" == "--jacazul-session" ]]; then
        _skip_next=true
    else
        CLEAN_ARGS+=("$arg")
    fi
done

# Prepare arguments: ensure the anchored persona is present if not specified
ARGS=("${CLEAN_ARGS[@]}")
if [[ "${CLEAN_ARGS[*]}" != *"--agent"* ]]; then
    ARGS=("--agent" "$JACAZUL_PERSONA" "${ARGS[@]}")
fi

# OpenCode discovers the project TUI configuration from its project path. When
# the launcher is called outside this repository, pass the project explicitly
# so tui.json and the local TUI extension are still loaded.
case "$(pwd)/" in
    "$PROJECT_ROOT"/*) ;;
    *) ARGS=("$PROJECT_ROOT" "${ARGS[@]}") ;;
esac

# Execute opencode directly to preserve TUI interactivity.
# The 'Initial Turn Protocol' in the JIT agent will guide the LLM.
"$OPENCODE_BIN" "${ARGS[@]}"

# Exit banner: only shown if an independent session file exists
FOCUS_FILE="$JACAZUL_HOME/.task/$PROJECT_ID/focus-$JACAZUL_SESSION_ID.json"
if [ -f "$FOCUS_FILE" ]; then
    echo ""
    echo "╭─ 🐊 Jacazul Session ───────────────────────────────────────╮"
    echo "│  To resume: jacazul-opencode --jacazul-session $JACAZUL_SESSION_ID      │"
    echo "╰────────────────────────────────────────────────────────────╯"
fi
