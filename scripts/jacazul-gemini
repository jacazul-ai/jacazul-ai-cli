#!/bin/bash
# jacazul-gemini: Gemini CLI unhinged (direct execution)

# Get the absolute path to the script's directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PROJECT_ROOT="$(readlink -f "$SCRIPT_DIR/..")"

# -----------------------------------------------------------------------------
# Runtime Bootstrap (Dynamics)
# -----------------------------------------------------------------------------
BOOTSTRAP_ENV="$PROJECT_ROOT/scripts/bootstrap/environment"
if [ -f "$BOOTSTRAP_ENV" ]; then
    source "$BOOTSTRAP_ENV"
else
    echo "❌ Jacazul runtime environment not found at $BOOTSTRAP_ENV" >&2
    exit 1
fi

# Export all context variables
export PROJECT_ID="$PROJECT_ID"
export CONTEXT_REAL_PATH="$(pwd)"
export CONTEXT_SYSTEM_USER="$(whoami)"
export CONTEXT_GIT_USER="${CONTEXT_GIT_USER:-$(whoami)}"
export GEMINI_INSTRUCTIONS_DIR="$PROJECT_ROOT/templates/context/instructions"

# Add workflow scripts to PATH
export PATH="$PATH:$PROJECT_ROOT/skills/taskwarrior_expert/scripts"

# -----------------------------------------------------------------------------
# System Prompt Governance (#46)
# -----------------------------------------------------------------------------
# Detect Gemini CLI version
GEMINI_VERSION=$(gemini --version 2>/dev/null || echo "unknown")
DUMPS_DIR="$PROJECT_ROOT/.gemini/system_dumps"
VERSION_DUMP="$DUMPS_DIR/system_$GEMINI_VERSION.md"
ACTIVE_PROMPT="$PROJECT_ROOT/.gemini/active-system.md"
ONBOARD_TEMPLATE="$PROJECT_ROOT/prompts/onboard.md"
CAPABILITIES_TEMPLATE="$PROJECT_ROOT/prompts/gemini_capabilities.md"

# Auto-dump if the version-specific prompt is missing
if [ ! -f "$VERSION_DUMP" ]; then
    [ -n "$DEBUG" ] && echo "🐊 Version dump missing for $GEMINI_VERSION. Performing auto-dump..."
    mkdir -p "$DUMPS_DIR"
    # Use 'skills list' as a trigger to initialize the agent engine and write the prompt
    GEMINI_WRITE_SYSTEM_MD="$VERSION_DUMP" gemini skills list > /dev/null 2>&1
    
    # Verify the dump was successful
    if [ ! -f "$VERSION_DUMP" ]; then
        echo "⚠️  Failed to dump system prompt for version $GEMINI_VERSION." >&2
    fi
fi

# Load and Process Onboard Prompt
PROCESSED_ONBOARD=$(mktemp)
if [ -f "$ONBOARD_TEMPLATE" ]; then
    (
        export JACAZUL_MODE="${JACAZUL_MODE:-COUNSELOR}"
        export JACAZUL_CHAT_LANG="${JACAZUL_CHAT_LANG:-pt-br}"
        export JACAZUL_DATA_LANG="${JACAZUL_DATA_LANG:-en}"
        
        eval "cat <<EOF
$(cat "$ONBOARD_TEMPLATE")
EOF" > "$PROCESSED_ONBOARD"
    )
else
    echo "⚠️  Onboard template missing at $ONBOARD_TEMPLATE" >&2
    echo "🚀 JACAZUL BOOTSTRAP PROTOCOL" > "$PROCESSED_ONBOARD"
fi

# -----------------------------------------------------------------------------
# Prompt Injection Strategy
# -----------------------------------------------------------------------------
if [ -f "$VERSION_DUMP" ]; then
    [ -n "$DEBUG" ] && echo "🐊 Generating active system prompt override (Gemini + Jacazul)..."
    cat "$VERSION_DUMP" > "$ACTIVE_PROMPT"
    echo -e "\n\n---\n" >> "$ACTIVE_PROMPT"
    cat "$PROCESSED_ONBOARD" >> "$ACTIVE_PROMPT"
    
    # Append Gemini-specific capabilities
    if [ -f "$CAPABILITIES_TEMPLATE" ]; then
        echo -e "\n" >> "$ACTIVE_PROMPT"
        cat "$CAPABILITIES_TEMPLATE" >> "$ACTIVE_PROMPT"
    fi
    
    export GEMINI_SYSTEM_MD="$ACTIVE_PROMPT"
    ONBOARD_PROMPT_ACTIVE=false
else
    ONBOARD_PROMPT_ACTIVE=true
fi

# Store the processed onboard text for fallback before deleting the temp file
ONBOARD_TEXT_FALLBACK=$(cat "$PROCESSED_ONBOARD")
rm -f "$PROCESSED_ONBOARD"

# Parse arguments for --resume
RESUME=false
CLEAN_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--resume" ]]; then
        RESUME=true
    else
        CLEAN_ARGS+=("$arg")
    fi
done

# Execute logic
if [ "$RESUME" = true ]; then
    set -- "${CLEAN_ARGS[@]}"
else
    if [ "$ONBOARD_PROMPT_ACTIVE" = false ]; then
        set -- "${CLEAN_ARGS[@]}"
    else
        if [ $# -eq 0 ]; then
            set -- -i "$ONBOARD_TEXT_FALLBACK"
        else
            USER_PROMPT="$*"
            set -- -i "$ONBOARD_TEXT_FALLBACK" "$USER_PROMPT"
        fi
    fi
fi

# Check if gemini is installed
if ! command -v gemini &> /dev/null; then
    echo "❌ gemini command not found in PATH." >&2
    exit 1
fi

[ -n "$DEBUG" ] && echo "🐊 jacazul-gemini: Starting for project [$PROJECT_ID]"

# DRY RUN: Exit before execution if DRY is set
if [ -n "$DRY" ]; then
    echo "✅ Dry run complete. Gemini bootstrap verified for project [$PROJECT_ID]."
    echo "🐊 Arguments for gemini: $@"
    exit 0
fi

exec gemini "$@"
