#!/bin/bash

# Determine the absolute project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# -----------------------------------------------------------------------------
# 0.0 Configure Language (Idiom) Preferences
# -----------------------------------------------------------------------------
CONFIGURE_LANGUAGE=false
if [ "$1" = "--language" ]; then
    CONFIGURE_LANGUAGE=true
fi

LANG_JSON="$HOME/.jacazul-ai/language.json"

if [ ! -f "$LANG_JSON" ] || [ "$CONFIGURE_LANGUAGE" = true ]; then
    echo "==================================="
    echo "Language (Idiom) Configuration"
    echo "==================================="
    echo ""
    
    echo "Options: portugues (pt-br), english (en), spanish (es)"
    read -p "What is the initial language do you want to talk (chat)? [pt-br]: " CHAT_LANG
    CHAT_LANG=${CHAT_LANG:-pt-br}
    
    read -p "What is the initial language do you want to keep the input (everything generated by me)? [en]: " DATA_LANG
    DATA_LANG=${DATA_LANG:-en}
    
    # Normalize inputs
    [[ "$CHAT_LANG" == "portugues" ]] && CHAT_LANG="pt-br"
    [[ "$CHAT_LANG" == "english" ]] && CHAT_LANG="en"
    [[ "$CHAT_LANG" == "spanish" ]] && CHAT_LANG="es"
    
    [[ "$DATA_LANG" == "portugues" ]] && DATA_LANG="pt-br"
    [[ "$DATA_LANG" == "english" ]] && DATA_LANG="en"
    [[ "$DATA_LANG" == "spanish" ]] && DATA_LANG="es"

    mkdir -p "$(dirname "$LANG_JSON")"
    echo "{\"chat\": \"$CHAT_LANG\", \"data\": \"$DATA_LANG\"}" > "$LANG_JSON"
    
    echo ""
    echo "✓ Language preferences saved to $LANG_JSON"
    echo ""
    
    # If only configuring language, exit early
    if [ "$CONFIGURE_LANGUAGE" = true ]; then
        exit 0
    fi
fi

# -----------------------------------------------------------------------------
# 0.1 Configure Gemini CLI Settings
# -----------------------------------------------------------------------------
GEMINI_BOOTSTRAP="$PROJECT_ROOT/scripts/bootstrap/gemini"
if [ -x "$GEMINI_BOOTSTRAP" ]; then
    "$GEMINI_BOOTSTRAP"
else
    echo "⚠️  Gemini bootstrap script not found or not executable at $GEMINI_BOOTSTRAP."
fi

# -----------------------------------------------------------------------------
# 0.2 Install Python Package (Entry Points)
# -----------------------------------------------------------------------------
VENV_BIN="$HOME/.jacazul-ai/.venv/bin"
if [ ! -d "$VENV_BIN" ]; then
    echo "🐊 Initializing Python virtual environment..."
    ./scripts/init-venv.sh
fi

if [ -x "/usr/bin/uv" ]; then
    echo "🐊 Installing Jacazul package via 'uv'..."
    VIRTUAL_ENV="$HOME/.jacazul-ai/.venv" /usr/bin/uv pip install -e .
else
    echo "🐊 Installing Jacazul package via 'pip'..."
    "$VENV_BIN/pip" install -e .
fi

# -----------------------------------------------------------------------------
# 0.3 Check Dependencies (Go & Cryptozoid)
# -----------------------------------------------------------------------------
if ! command -v go &> /dev/null; then
    echo "❌ ERROR: 'go' is not installed. It is REQUIRED for security and platform tools."
    echo "   Action: Please install Go (https://go.dev/doc/install) and try again."
    exit 1
fi

CRYPTOZOID_BIN="$HOME/go/bin/cryptozoid"
if ! command -v cryptozoid &> /dev/null && [ ! -f "$CRYPTOZOID_BIN" ]; then
    echo "🐊 'cryptozoid' (IdZoid) not found. Installing..."
    go install github.com/idzoid/cryptozoid/cmd/cryptozoid@latest
fi

# Ensure cryptozoid is in PATH for the rest of the script
export PATH="$HOME/go/bin:$PATH"

# -----------------------------------------------------------------------------
# 0.4 Initialize Jacazul Vault (IdZoid Security)
# -----------------------------------------------------------------------------
VAULT_NAME="jacazul-vault"
VAULT_DIR="$HOME/.jacazul-ai"
if [ ! -f "$VAULT_DIR/${VAULT_NAME}_private.pem" ]; then
    echo "🐊 Initializing Jacazul Vault (EC P256)..."
    mkdir -p "$VAULT_DIR"
    # Use the absolute path to the bin if not in PATH yet
    "$CRYPTOZOID_BIN" ec generate -n "$VAULT_NAME" -p "$VAULT_DIR"
    echo "✅ Vault initialized at $VAULT_DIR"
fi

# -----------------------------------------------------------------------------
# 1. Setup Sandbox Directory (SELinux & Permissions)
# -----------------------------------------------------------------------------
SANDBOX_DIR="$PROJECT_ROOT/sandbox/copilot/.copilot"

echo "Configuring sandbox directory at: $SANDBOX_DIR"
mkdir -p "$SANDBOX_DIR"

# Apply SELinux label 'container_file_t' if chcon is available
if command -v chcon &> /dev/null; then
    echo "Applying SELinux context (container_file_t)..."
    if chcon -Rt container_file_t "$SANDBOX_DIR"; then
        echo "✅ SELinux context applied successfully."
    else
        echo "⚠️  Failed to apply SELinux context. You might need to run this manually or check permissions."
    fi
else
    echo "ℹ️  'chcon' not found. Skipping SELinux configuration (not required on non-SELinux systems)."
fi

# -----------------------------------------------------------------------------
# 2. Setup Wrapper Script in ~/bin
# -----------------------------------------------------------------------------
if [ ! -d "$HOME/bin" ]; then
    echo "Directory ~/bin does not exist. Creating..."
    mkdir -p "$HOME/bin"
fi

TARGET_SCRIPT="$HOME/bin/copilot_sandboxed"
echo "Creating wrapper script at $TARGET_SCRIPT..."

cat <<EOF > "$TARGET_SCRIPT"
#!/bin/bash
export PROJECT_ROOT="$PROJECT_ROOT"
export COPILOT_SANDBOXED_HOME="\$PROJECT_ROOT"

# Execute the project script
"\$PROJECT_ROOT/scripts/copilot" "\$@"
EOF

# -----------------------------------------------------------------------------
# 3. Setup CLI links in ~/bin
# -----------------------------------------------------------------------------
CLI_LINKS=(
    "jacazul-gemini:scripts/jacazul-gemini"
    "jacazul-opencode:scripts/jacazul-opencode"
    "jacazul-copilot:scripts/jacazul-copilot"
    "jacazul-claude:scripts/jacazul-claude"
    "jacazul-pi:scripts/jacazul-pi"
    "python:scripts/python"
    "tw-flow:$HOME/.jacazul-ai/.venv/bin/tw-flow"
    "taskp:$HOME/.jacazul-ai/.venv/bin/taskp"
    "ponder:$HOME/.jacazul-ai/.venv/bin/ponder"
    "jacazul-hatch:$HOME/.jacazul-ai/.venv/bin/jacazul-hatch"
    "jacazul-persona:$HOME/.jacazul-ai/.venv/bin/jacazul-persona"
    "jacazul-github:$HOME/.jacazul-ai/.venv/bin/jacazul-github"
    "jacazul-broker:$HOME/.jacazul-ai/.venv/bin/jacazul-broker"
    "py-check:$HOME/.jacazul-ai/.venv/bin/py-check"
)

for entry in "${CLI_LINKS[@]}"; do
    LINK_NAME="${entry%%:*}"
    LINK_TARGET="${entry#*:}"
    
    # Resolve relative paths against PROJECT_ROOT
    if [[ "$LINK_TARGET" != /* ]]; then
        LINK_TARGET="$PROJECT_ROOT/$LINK_TARGET"
    fi
    
    LINK_PATH="$HOME/bin/$LINK_NAME"
    if [ ! -L "$LINK_PATH" ] && [ ! -f "$LINK_PATH" ]; then
        echo "Creating symbolic link for $LINK_NAME at $LINK_PATH..."
        ln -s "$LINK_TARGET" "$LINK_PATH"
        echo "✅ Link created: $LINK_PATH"
    else
        echo "ℹ️  $LINK_PATH already exists. Skipping link creation."
    fi
done

echo ""
echo "Setup complete! The following tools are available in ~/bin:"
for entry in "${CLI_LINKS[@]}"; do
    echo "  - ${entry%%:*}"
done
        